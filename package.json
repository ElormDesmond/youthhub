{
  "name": "youth-register-attendance-system",
  "version": "1.0.0",
  "description": "Full-Stack Church Youth Register & Attendance System",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "node backend/server.js",
    "db:init": "npm --prefix backend run db:init",
    "db:seed": "npm --prefix backend run db:seed",
    "test": "npm --prefix backend test",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
